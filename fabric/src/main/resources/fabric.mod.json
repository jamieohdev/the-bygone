{
  "schemaVersion": 1,
  "id": "${modid}",
  "version": "${version}",
  "entrypoints": {
    "main": [ "com.jamiedev.bygone.BygoneFabric" ],
    "client": [ "com.jamiedev.bygone.client.BygoneClientFabric" ]
  },
  "mixins": [
    "${modid}.mixins.json",
    "${modid}.fabric.mixins.json"
  ],
  "accessWidener": "${modid}.classtweaker",
  "depends": {
    "minecraft": "1.21.1",
    "fabricloader": ">=0.19.0",
    "fabric-api": ">=0.115.6",
    "jinxedlib": ">=1.0.3",
    "lithostitched": ">=1.7.0",
    "moredensityfunctions": ">=2.3.0"
  },

  "name": "${modname}",
  "description": "${description}",
  "icon": "icon.png",
  "authors": [
    "${credits_programmers}",
    "${credits_planning}",
    "${credits_artists}",
    "${credits_sound}",
    "${credits_playtesting}",
    "${credits_trailer}"
  ],
  "contributors": [ "${credits_other}" ],
  "contact": {
    "homepage": "${contact_modrinth}",
    "sources": "${contact_repo}",
    "discord": "${contact_discord}"
